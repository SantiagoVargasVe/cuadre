{
  "name": "cuadre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "npm run lint && npm run typecheck && npm run test -- --coverage && npm run build",
    "db:up": "docker compose -f infra/docker-compose.dev.yml --project-directory . up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.dev.yml --project-directory . down",
    "db:logs": "docker compose -f infra/docker-compose.dev.yml --project-directory . logs -f postgres",
    "db:reset": "docker compose -f infra/docker-compose.dev.yml --project-directory . down -v && npm run db:up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:invite": "tsx scripts/seed-invite.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@node-rs/argon2": "^2.1.0",
    "@tanstack/react-query": "^5.102.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "nanoid": "^6.0.1",
    "next": "15.5.24",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.24",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
