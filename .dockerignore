# Build context is the repo root. Keep it to source + package manifests; the
# build installs its own node_modules and produces its own .next.
node_modules
.next
out
build
coverage
data
.git
.github

# Never bake secrets into a layer. .env.example is safe and harmless to ship.
.env
.env.*
!.env.example

*.tsbuildinfo
*.log
.DS_Store

# Not needed at runtime.
docs
backlog
coverage
