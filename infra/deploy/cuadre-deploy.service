[Unit]
Description=Pull and apply the latest cuadre image
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The directory holding docker-compose.yml (a copy of
# infra/docker-compose.prod.yml) and the chmod 600 .env. Adjust to wherever
# the operator put the stack.
WorkingDirectory=/home/robin/nas/cuadre
# `pull` is a no-op when the digest is unchanged, and `up -d` only recreates
# the container if the image actually moved — so a tick with nothing new costs
# one registry HEAD request.
ExecStart=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d
User=robin
Group=docker
