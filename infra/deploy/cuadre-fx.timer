[Unit]
Description=Refresh Cuadre FX rates once a day

[Timer]
# ~02:00 UTC: after the provider publishes (~00:00–00:30 UTC), and off the top
# of the hour where every other timer on the box fires.
OnCalendar=*-*-* 02:00:00 UTC
RandomizedDelaySec=20min
# A run missed while the box was off fires on the next boot. Not urgent — the
# conversion path fetches on demand as a fallback — but there's no reason to
# skip a whole day.
Persistent=true

[Install]
WantedBy=timers.target
