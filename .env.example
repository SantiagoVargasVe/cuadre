# ─── App ──────────────────────────────────────────────────────────────────────
# Public origin. Used for invite links and absolute URLs. No trailing slash.
APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=cuadre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cuadre
DATABASE_URL=postgres://cuadre:change-me@localhost:5432/cuadre

# Integration tests run against a separate database created by infra/postgres-init/.
# Unset locally = integration tests skip. Unset in CI = CI fails (see docs/context/testing.md).
DATABASE_URL_TEST=postgres://cuadre:change-me@localhost:5432/cuadre_test

# ─── Auth ─────────────────────────────────────────────────────────────────────
# 32+ chars. Rotating this logs everyone out; nothing else breaks.
#   openssl rand -base64 48
AUTH_SECRET=

# ─── Currency / FX ────────────────────────────────────────────────────────────
# Supported everywhere in the app. Adding one means checking the provider covers it
# AND that its ISO-4217 minor-unit exponent is handled — see docs/context/currency.md.
SUPPORTED_CURRENCIES=COP,USD,EUR
DEFAULT_CURRENCY=COP

# Primary rate provider. open.er-api.com needs no key on its free tier and covers COP.
# Do NOT swap this for an ECB-backed API (Frankfurter et al.) — the ECB does not
# publish COP. See docs/adr/0008-fx-provider-and-daily-refresh.md.
FX_PROVIDER=open-er-api
FX_BASE_CURRENCY=USD

# Optional authoritative cross-check for the COP/USD leg: Colombia's official TRM.
# Leave enabled; it is free, keyless, and catches a bad primary response.
FX_TRM_CROSSCHECK=true

# Refresh is triggered externally (systemd timer → POST /api/admin/fx/refresh).
# 32+ chars. Unset disables the endpoint entirely rather than leaving it open.
#   openssl rand -hex 32
FX_REFRESH_TOKEN=
